generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  onDuty       Boolean  @default(false)
  onDutySince  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AdminAuditLog[]
  pushDevices  AdminPushDevice[]
  notificationReads AdminNotificationRead[]

  @@index([active, role])
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  actorId     String?
  actor       AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  details     Json?
  createdAt   DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model AdminPushDevice {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  token       String    @unique
  deviceName  String?
  platform    String?
  userAgent   String?
  active      Boolean   @default(true)
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([adminUserId, active])
  @@index([active, lastSeenAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  keyHash   String
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
  @@index([createdAt])
}

model SiteSettings {
  translations Json?
  id                        String   @id @default("main")
  siteName                  String   @default("Pousada Moriah")
  tagline                   String   @default("Seu lugar perto de tudo. Do seu jeito.")
  whatsapp                  String?
  whatsappFloatingEnabled   Boolean  @default(true)
  whatsappFloatingMessage   String   @default("Olá! Vim pelo site da Moriah e gostaria de atendimento.")
  whatsappFloatingLabel     String   @default("Fale no WhatsApp")
  whatsappFloatingPosition  String   @default("LEFT")
  instagram                 String?
  address                   String?
  logoUrl                   String?
  logoLightUrl              String?
  faviconUrl                String?
  defaultBackgroundImageUrl String?
  primaryColor              String   @default("#0b607a")
  secondaryColor            String   @default("#073b4c")
  accentColor               String   @default("#ffc845")
  backgroundColor           String   @default("#f4f7f8")
  textColor                 String   @default("#1b252b")
  buttonColor               String   @default("#0b607a")
  updatedAt                 DateTime @updatedAt
}

model SitePage {
  translations Json?
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  description    String?
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  navLabel       String?
  showInNav      Boolean       @default(false)
  sortOrder      Int           @default(100)
  published      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sections       SiteSection[]

  @@index([showInNav, sortOrder])
}

model SiteSection {
  translations Json?
  id                String   @id @default(cuid())
  pageId            String
  page              SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type              String
  eyebrow           String?
  title             String?
  subtitle          String?
  body              String?
  imageUrl          String?
  imageAlt          String?
  mediaUrls         String[] @default([])
  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  videoUrl          String?
  anchorId          String?
  backgroundImageUrl String?
  backgroundColor   String?
  textColor         String?
  animation         String   @default("FADE_UP")
  animationDelay    Int      @default(0)
  paddingY          Int      @default(96)
  contentWidth      String   @default("NORMAL")
  hideMobile        Boolean  @default(false)
  hideDesktop       Boolean  @default(false)
  theme             String   @default("LIGHT")
  layout            String   @default("DEFAULT")
  sortOrder         Int      @default(100)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([pageId, active, sortOrder])
  @@index([anchorId])
}

model Accommodation {
  translations Json?
  id                  String               @id @default(cuid())
  name                String
  description         String
  type                String
  priceCents          Int?
  capacity            Int                  @default(2)
  active              Boolean              @default(true)
  featured            Boolean              @default(false)
  coverImage          String?
  galleryImages       String[]             @default([])
  internalCode        String?              @unique
  roomNumber          String?
  floor               String?
  maxAdults           Int                  @default(2)
  maxChildren         Int                  @default(0)
  beds                String?
  sharedRoom          Boolean              @default(false)
  bedCount            Int                  @default(0)
  bathrooms           Int                  @default(1)
  areaSqm             Float?
  amenities           String[]             @default([])
  rules               String?
  checkInTime         String               @default("14:00")
  checkOutTime        String               @default("12:00")
  internalNotes       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bookingLeads        BookingLead[]
  channelIntegrations ChannelIntegration[]
  ratePlans           RatePlan[]
  rateRules           RateRule[]
  housekeepingTasks   HousekeepingTask[]
  inventoryHolds      InventoryHold[]
  manualBlocks        ManualInventoryBlock[]
}

model Promotion {
  translations Json?
  id          String    @id @default(cuid())
  title       String
  description String?
  coupon      String?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  discountType  String?
  discountValue Int?
  minNights     Int?
  accommodationId String?
  stackable     Boolean @default(false)
  updatedAt   DateTime  @updatedAt
}

model Media {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  label      String?
  folder     String?
  sortOrder  Int      @default(0)
  storageKey String?  @unique
  mimeType   String?
  sizeBytes  Int?
  provider   String   @default("EXTERNAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([folder, sortOrder, createdAt])
}

model BookingLead {
  id              String         @id @default(cuid())
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  name            String
  email           String?
  phone           String
  checkIn         DateTime?
  checkOut        DateTime?
  guests          Int            @default(1)
  message         String?
  status          String         @default("NEW")
  source          String         @default("SITE")
  publicRequestToken String?      @unique
  quotedTotalCents Int?
  quotedCurrency  String?
  quotedRatePlan  String?
  quoteSnapshot   Json?
  quotedAt        DateTime?
  guestId         String?
  guest           Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  noShowAt        DateTime?
  restaurantAccessToken String? @unique
  payments        Payment[]
  auditLogs       BookingAuditLog[]
  housekeepingTasks HousekeepingTask[]
  restaurantOrders RestaurantOrder[]
  restaurantRoomCharges RestaurantRoomCharge[]
  charges         BookingCharge[]
  companions      BookingCompanion[]
  rentals         RentalOrder[]
  internalNotes   String?
  createdAt       DateTime       @default(now())

  @@index([accommodationId])
  @@index([guestId])
}

model IntegrationSettings {
  id                        String   @id @default("main")
  firebaseApiKey            String?
  firebaseAuthDomain        String?
  firebaseProjectId         String?
  firebaseStorageBucket     String?
  firebaseMessagingSenderId String?
  firebaseAppId             String?
  firebaseVapidKey          String?
  chatEnabled               Boolean  @default(true)
  chatName                  String   @default("Moriah Assistente")
  chatWelcome               String   @default("Olá! Sou o assistente virtual da Moriah. Como posso ajudar com sua hospedagem?")
  chatInstructions          String?
  groqModel                 String   @default("openai/gpt-oss-20b")
  groqTemperature           Float    @default(0.2)
  updatedAt                 DateTime @updatedAt
}

model BlogPost {
  translations Json?
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ChannelIntegration {
  id              String         @id @default(cuid())
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  blocks          ChannelBlock[]
  provider        String
  integrationType String         @default("ICAL")
  name            String
  importUrl       String?
  exportToken     String?        @unique
  active          Boolean        @default(true)
  lastSyncAt      DateTime?
  lastAttemptAt   DateTime?
  lastSuccessAt   DateTime?
  syncStatus      String         @default("IDLE")
  lastError       String?
  etag            String?
  lastModified    String?
  consecutiveFailures Int @default(0)
  nextSyncAt      DateTime?
  syncDurationMs  Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([accommodationId])
  @@index([nextSyncAt])
}

model InventoryHold {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  checkIn         DateTime
  checkOut        DateTime
  token           String        @unique
  expiresAt       DateTime
  units           Int           @default(1)
  createdAt       DateTime      @default(now())

  @@index([accommodationId, checkIn, checkOut])
  @@index([expiresAt])
}

model ManualInventoryBlock {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime
  reason          String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([accommodationId, startsAt, endsAt])
}

model ChannelBlock {
  id            String             @id @default(cuid())
  integrationId String
  integration   ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalUid   String
  summary       String?
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalUid])
  @@index([startsAt, endsAt])
  @@index([integrationId])
}

model RatePlan {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  currency        String        @default("BRL")
  basePriceCents  Int
  minNights       Int           @default(1)
  maxNights       Int?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  overrides       RateOverride[]

  @@index([accommodationId, active])
}

model RateRule {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  adjustmentType  String        @default("PERCENT")
  adjustmentValue Int
  minOccupancyPct Int?
  maxOccupancyPct Int?
  daysBeforeMin   Int?
  daysBeforeMax   Int?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean       @default(true)
  priority        Int           @default(100)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([accommodationId, active, priority])
}

model RateOverride {
  id             String   @id @default(cuid())
  ratePlanId     String
  ratePlan       RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  priceCents     Int
  minNights      Int?
  closedToArrival Boolean @default(false)
  closedToDeparture Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ratePlanId, startsAt, endsAt])
}

model ChatMetric {
  id        String   @id @default(cuid())
  kind      String
  createdAt DateTime @default(now())
  @@index([kind, createdAt])
}

model NotificationMessage {
  id          String   @id @default(cuid())
  dedupeKey   String?  @unique
  channel     String
  audience    String   @default("INTERNAL")
  recipient   String?
  title       String
  body        String
  status      String   @default("READY")
  scheduledAt DateTime?
  sentAt      DateTime?
  error       String?
  actionUrl   String?
  createdAt   DateTime @default(now())
  reads       AdminNotificationRead[]
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([channel, createdAt])
  @@index([audience, status, createdAt])
}

model AdminNotificationRead {
  id             String              @id @default(cuid())
  adminUserId    String
  adminUser      AdminUser           @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  notificationId String
  notification   NotificationMessage @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime            @default(now())

  @@unique([adminUserId, notificationId])
  @@index([adminUserId, readAt])
  @@index([notificationId])
}

model NotificationRule {
  id              String   @id @default(cuid())
  module          String
  eventKey        String
  label           String
  active          Boolean  @default(true)
  channels        String[] @default(["IN_APP"])
  audience        String   @default("INTERNAL")
  advanceMinutes  Int      @default(0)
  templateTitle   String?
  templateBody    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([module, eventKey])
  @@index([module, active])
}

model CalendarWidgetSettings {
  id           String   @id @default("main")
  publicToken  String   @unique @default(cuid())
  active       Boolean  @default(true)
  title        String   @default("Disponibilidade Moriah")
  subtitle     String?
  primaryColor String   @default("#0b607a")
  accentColor  String   @default("#ffc845")
  showPrices   Boolean  @default(true)
  allowBooking Boolean  @default(true)
  compact      Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model RentalItem {
  id               String        @id @default(cuid())
  name             String
  category         String        @default("BIKE")
  description      String?
  imageUrl         String?
  active           Boolean       @default(true)
  quantityTotal    Int           @default(1)
  hourlyPriceCents Int?
  dailyPriceCents  Int?
  depositCents     Int           @default(0)
  sortOrder        Int           @default(100)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  rentals          RentalOrder[]

  @@index([active, sortOrder])
  @@index([category, active])
}

model RentalOrder {
  id             String      @id @default(cuid())
  itemId         String
  item           RentalItem  @relation(fields:[itemId],references:[id],onDelete:Restrict)
  guestId        String?
  guest          Guest?      @relation(fields:[guestId],references:[id],onDelete:SetNull)
  bookingId      String?
  booking        BookingLead? @relation(fields:[bookingId],references:[id],onDelete:SetNull)
  renterName     String
  phone          String?
  quantity       Int         @default(1)
  pricingMode    String      @default("HOURLY")
  unitPriceCents Int
  startAt        DateTime
  dueAt          DateTime
  returnedAt     DateTime?
  status         String      @default("ACTIVE")
  totalCents     Int
  depositCents   Int         @default(0)
  paymentStatus  String      @default("PENDING")
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([itemId, status, startAt, dueAt])
  @@index([bookingId, status])
  @@index([guestId, status])
  @@index([dueAt, status])
}

model Guest {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String
  document         String?
  documentType     String?
  birthDate        DateTime?
  nationality      String?
  address          String?
  city             String?
  state            String?
  postalCode       String?
  preferences      String?
  emergencyContact String?
  notes            String?
  monthlyGuest             Boolean   @default(false)
  monthlyPaymentDueAt      DateTime?
  monthlyPaymentLastPaidAt DateTime?
  employee                 Boolean   @default(false)
  staffAssignment          StaffAssignment?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bookings         BookingLead[]
  rentals          RentalOrder[]

  @@index([phone])
  @@index([document])
  @@index([monthlyGuest])
  @@index([monthlyGuest, monthlyPaymentDueAt])
  @@index([employee])
}

model StaffPosition {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  active      Boolean           @default(true)
  sortOrder   Int               @default(100)
  assignments StaffAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([active, sortOrder])
}

model StaffAssignment {
  id         String        @id @default(cuid())
  guestId    String        @unique
  guest      Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  positionId String
  position   StaffPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([positionId])
}

model BookingCompanion {
  id        String      @id @default(cuid())
  bookingId String
  booking   BookingLead @relation(fields:[bookingId],references:[id],onDelete:Cascade)
  name      String
  document  String?
  birthDate DateTime?
  notes     String?
  createdAt DateTime    @default(now())

  @@index([bookingId])
}
model Payment {
  id String @id @default(cuid())
  bookingId String
  booking BookingLead @relation(fields:[bookingId],references:[id],onDelete:Cascade)
  amountCents Int
  currency String @default("BRL")
  method String
  source String @default("INTERNAL")
  status String @default("PAID")
  reference String?
  paidAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([bookingId,status])
}
model BookingCharge {
  id          String      @id @default(cuid())
  bookingId   String
  booking     BookingLead @relation(fields:[bookingId],references:[id],onDelete:Cascade)
  description String
  amountCents Int
  category    String      @default("CHECKIN_EXTRA")
  createdAt   DateTime    @default(now())

  @@index([bookingId,createdAt])
}

model HousekeepingTask {
  id String @id @default(cuid())
  accommodationId String
  accommodation Accommodation @relation(fields:[accommodationId],references:[id],onDelete:Cascade)
  bookingId String?
  booking BookingLead? @relation(fields:[bookingId],references:[id],onDelete:SetNull)
  type String @default("CLEANING")
  status String @default("PENDING")
  scheduledFor DateTime
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([scheduledFor,status])
  @@index([bookingId])
}
model BookingAuditLog {
  id String @id @default(cuid())
  bookingId String
  booking BookingLead @relation(fields:[bookingId],references:[id],onDelete:Cascade)
  action String
  details Json?
  createdAt DateTime @default(now())
  @@index([bookingId,createdAt])
}

model RestaurantCategory {
  translations Json?
 id String @id @default(cuid())
 name String
 description String?
 imageUrl String?
 sortOrder Int @default(0)
 active Boolean @default(true)
 featured Boolean @default(false)
 targetCmvPct Float?
 availableFrom String?
 availableUntil String?
 availableDays Int[] @default([])
 products RestaurantProduct[]

 @@index([active,sortOrder])
}
model RestaurantProduct {
  translations Json?
 id String @id @default(cuid())
 categoryId String
 category RestaurantCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 stationId String?
 station RestaurantStation? @relation(fields:[stationId],references:[id],onDelete:SetNull)
 name String
 description String?
 imageUrl String?
 priceCents Int
 promotionalPriceCents Int?
 costCents Int?
 targetCmvPct Float?
 sku String? @unique
 active Boolean @default(true)
 featured Boolean @default(false)
 soldOut Boolean @default(false)
 pauseUntil DateTime?
 badge String?
 tags String[] @default([])
 allergens String[] @default([])
 sortOrder Int @default(0)
 prepMinutes Int?
 priorityWeight Int @default(100)
 kitchenInstructions String?
 platingNotes String?
 maxPerOrder Int @default(20)
 allowNotes Boolean @default(true)
 availableFrom String?
 availableUntil String?
 availableDays Int[] @default([])
 trackStock Boolean @default(true)
 stockQty Int @default(0)
 minStockQty Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 orderItems RestaurantOrderItem[]
 stockMovements RestaurantStockMovement[]
 recipes RestaurantRecipeItem[]
 modifierLinks RestaurantProductModifierGroup[]
 productionBatches RestaurantProductionBatch[]
 @@index([categoryId,active,sortOrder])
 @@index([featured,active])
 @@index([stationId,active])
 @@index([pauseUntil])
}
model RestaurantOrder {
 id String @id @default(cuid())
 bookingId String?
 booking BookingLead? @relation(fields:[bookingId],references:[id],onDelete:SetNull)
 guestName String
 roomLabel String?
 phone String?
 status String @default("NEW")
 priority String @default("NORMAL")
 source String @default("WEB")
 expeditionStatus String @default("PENDING")
 preparingAt DateTime?
 estimatedReadyAt DateTime?
 readyAt DateTime?
 deliveredAt DateTime?
 cancelledAt DateTime?
 pausedAt DateTime?
 pauseReason String?
 paymentMethod String @default("ROOM")
 paymentStatus String @default("PENDING")
 subtotalCents Int
 totalCents Int
 notes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 items RestaurantOrderItem[]
 roomCharge RestaurantRoomCharge?
 kitchenEvents RestaurantKitchenEvent[]
 @@index([status,createdAt])
 @@index([bookingId])
 @@index([priority,status,createdAt])
 @@index([expeditionStatus,status])
}
model RestaurantOrderItem {
 id String @id @default(cuid())
 orderId String
 order RestaurantOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
 productId String
 product RestaurantProduct @relation(fields:[productId],references:[id],onDelete:Restrict)
 stationId String?
 station RestaurantStation? @relation(fields:[stationId],references:[id],onDelete:SetNull)
 nameSnapshot String
 kitchenInstructionsSnapshot String?
 unitPriceCents Int
 unitCostCents Int?
 quantity Int
 totalCents Int
 notes String?
 kitchenStatus String @default("PENDING")
 startedAt DateTime?
 readyAt DateTime?
 modifiers RestaurantOrderItemModifier[]
 kitchenEvents RestaurantKitchenEvent[]
 @@index([orderId])
 @@index([productId])
 @@index([stationId,kitchenStatus])
 @@index([orderId,kitchenStatus])
}
model RestaurantStockMovement {
 id String @id @default(cuid())
 productId String
 product RestaurantProduct @relation(fields:[productId],references:[id],onDelete:Cascade)
 type String
 quantity Int
 reason String?
 orderId String?
 createdAt DateTime @default(now())
 @@index([productId,createdAt])
}

model RestaurantSettings {
 translations Json?
 id String @id @default("main")
 openTime String @default("07:00")
 closeTime String @default("22:00")
 acceptingOrders Boolean @default(true)
 roomChargeEnabled Boolean @default(true)
 prepTargetMinutes Int @default(25)
 kitchenWarningMinutes Int @default(20)
 kitchenCriticalMinutes Int @default(35)
 stationMode Boolean @default(true)
 expeditionEnabled Boolean @default(true)
 autoReadyOrder Boolean @default(true)
 kdsSoundEnabled Boolean @default(true)
 menuTitle String @default("Moriah Food")
 menuSubtitle String?
 menuBannerUrl String?
 showSoldOut Boolean @default(true)
 updatedAt DateTime @updatedAt
}

model RestaurantStation {
 id String @id @default(cuid())
 name String
 code String @unique
 description String?
 color String @default("#0b607a")
 active Boolean @default(true)
 sortOrder Int @default(100)
 targetMinutes Int @default(15)
 products RestaurantProduct[]
 orderItems RestaurantOrderItem[]
 productionBatches RestaurantProductionBatch[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([active,sortOrder])
}

model RestaurantKitchenEvent {
 id String @id @default(cuid())
 orderId String
 order RestaurantOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
 itemId String?
 item RestaurantOrderItem? @relation(fields:[itemId],references:[id],onDelete:Cascade)
 eventType String
 fromStatus String?
 toStatus String?
 notes String?
 actorId String?
 actorName String?
 details Json?
 createdAt DateTime @default(now())

 @@index([orderId,createdAt])
