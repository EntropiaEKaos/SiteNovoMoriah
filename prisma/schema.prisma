  @@unique([campaignKey, phone])
  @@index([createdAt])
}

model RouletteSpin {
  id             String        @id @default(cuid())
  entryId        String        @unique
  entry          RouletteEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  prizeId        String
  prize          RoulettePrize @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  claimCode      String        @unique
  wheelSnapshot  Json
  resultSnapshot Json
  expiresAt      DateTime?
  redeemedAt     DateTime?
  redeemedBy     String?
  createdAt      DateTime      @default(now())

  @@index([prizeId, createdAt])
  @@index([redeemedAt, createdAt])
}
