generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id        String   @id @default("main")
  siteName  String   @default("Pousada Moriah")
  tagline   String   @default("Seu lugar perto de tudo. Do seu jeito.")
  whatsapp  String?
  instagram String?
  address   String?
  updatedAt DateTime @updatedAt
}

model Accommodation {
  id                  String               @id @default(cuid())
  name                String
  description         String
  type                String
  priceCents          Int?
  capacity            Int                  @default(2)
  active              Boolean              @default(true)
  featured            Boolean              @default(false)
  coverImage          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bookingLeads        BookingLead[]
  channelIntegrations ChannelIntegration[]
  ratePlans           RatePlan[]
  rateRules           RateRule[]
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  description String?
  coupon      String?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  discountType  String?
  discountValue Int?
  minNights     Int?
  accommodationId String?
  stackable     Boolean @default(false)
  updatedAt   DateTime  @updatedAt
}

model Media {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  storageKey String?  @unique
  mimeType   String?
  sizeBytes  Int?
  provider   String   @default("EXTERNAL")
  createdAt  DateTime @default(now())
}

model BookingLead {
  id              String         @id @default(cuid())
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  name            String
  email           String?
  phone           String
  checkIn         DateTime?
  checkOut        DateTime?
  guests          Int            @default(1)
  message         String?
  status          String         @default("NEW")
  source          String         @default("SITE")
  quotedTotalCents Int?
  quotedCurrency  String?
  quotedRatePlan  String?
  quoteSnapshot   Json?
  quotedAt        DateTime?
  createdAt       DateTime       @default(now())

  @@index([accommodationId])
}

model IntegrationSettings {
  id                        String   @id @default("main")
  firebaseApiKey            String?
  firebaseAuthDomain        String?
  firebaseProjectId         String?
  firebaseStorageBucket     String?
  firebaseMessagingSenderId String?
  firebaseAppId             String?
  firebaseVapidKey          String?
  chatEnabled               Boolean  @default(true)
  chatName                  String   @default("Moriah Assistente")
  chatWelcome               String   @default("Olá! Sou o assistente virtual da Moriah. Como posso ajudar com sua hospedagem?")
  chatInstructions          String?
  groqModel                 String   @default("llama-3.1-8b-instant")
  groqTemperature           Float    @default(0.2)
  updatedAt                 DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ChannelIntegration {
  id              String         @id @default(cuid())
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  blocks          ChannelBlock[]
  provider        String
  integrationType String         @default("ICAL")
  name            String
  importUrl       String?
  exportToken     String?        @unique
  active          Boolean        @default(true)
  lastSyncAt      DateTime?
  lastAttemptAt   DateTime?
  lastSuccessAt   DateTime?
  syncStatus      String         @default("IDLE")
  lastError       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([accommodationId])
}

model ChannelBlock {
  id            String             @id @default(cuid())
  integrationId String
  integration   ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalUid   String
  summary       String?
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalUid])
  @@index([startsAt, endsAt])
  @@index([integrationId])
}

model RatePlan {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  currency        String        @default("BRL")
  basePriceCents  Int
  minNights       Int           @default(1)
  maxNights       Int?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  overrides       RateOverride[]

  @@index([accommodationId, active])
}

model RateRule {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  adjustmentType  String        @default("PERCENT")
  adjustmentValue Int
  minOccupancyPct Int?
  maxOccupancyPct Int?
  daysBeforeMin   Int?
  daysBeforeMax   Int?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean       @default(true)
  priority        Int           @default(100)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([accommodationId, active, priority])
}

model RateOverride {
  id             String   @id @default(cuid())
  ratePlanId     String
  ratePlan       RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  priceCents     Int
  minNights      Int?
  closedToArrival Boolean @default(false)
  closedToDeparture Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ratePlanId, startsAt, endsAt])
}

model ChatMetric {
  id        String   @id @default(cuid())
  kind      String
  createdAt DateTime @default(now())
  @@index([kind, createdAt])
}
