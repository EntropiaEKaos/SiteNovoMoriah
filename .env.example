NEXT_PUBLIC_SITE_URL="https://moriah-khaki.vercel.app"
# Runtime/serverless traffic: use Prisma Postgres pooled connection.
DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Production migrations/admin tooling: use the direct Prisma Postgres connection.
DIRECT_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_BOOTSTRAP_TOKEN="replace-with-a-one-time-random-bootstrap-token"

# Groq / Moriah Assistente
GROQ_API_KEY=""
GROQ_CHAT_MODEL="llama-3.1-8b-instant"

# Amazon S3 private media storage
AWS_REGION="sa-east-1"
AWS_S3_BUCKET="moriah-media-prod"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional CDN reference. Private media has a secure application fallback.
AWS_CLOUDFRONT_URL=""

# Scheduled channel synchronization
CRON_SECRET="replace-with-a-long-random-secret"

# Firebase public web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Optional Firebase server-side credential for future automatic push delivery.
# Never expose this value with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional outbound e-mail provider
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Pousada Moriah <reservas@example.com>"
